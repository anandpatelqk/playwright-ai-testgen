# ----------------------------------------------------------------------------
# playwright-ai-testgen environment configuration
# Copy this file to `.env` and fill in your values.
# ----------------------------------------------------------------------------

# OpenAI API key (required for AI-powered test generation)
OPENAI_API_KEY=your_api_key_here

# OpenAI model (default: gpt-5.5)
OPENAI_MODEL=gpt-5.5

# Optional organization / project IDs for org-scoped keys
# OPENAI_ORG_ID=org_xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_PROJECT_ID=proj_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional custom base URL (e.g. for Azure OpenAI or compatible proxies)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Maximum output tokens per generation request
OPENAI_MAX_TOKENS=8192

# Default base URL used for crawling/test generation
TARGET_BASE_URL=https://example.com

# Output directory for generated Playwright tests
GENERATED_TESTS_DIR=tests/generated

# Output directory for custom JSON reports
REPORTS_DIR=reports

# Crawler timeouts (milliseconds)
PAGE_LOAD_TIMEOUT_MS=30000
PAGE_IDLE_TIMEOUT_MS=2000

# Logging level: debug | info | warn | error
LOG_LEVEL=info
