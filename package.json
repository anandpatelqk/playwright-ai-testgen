{
  "name": "playwright-ai-testgen",
  "version": "0.1.0",
  "description": "AI-powered Playwright test generation framework using OpenAI GPT-5.5",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ai-testgen": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prebuild": "pnpm run clean",
    "dev": "tsx src/cli.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "generate": "pnpm run build && node dist/cli.js generate",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "playwright",
    "ai",
    "test-generation",
    "openai",
    "gpt",
    "automation",
    "testing",
    "e2e"
  ],
  "author": "anandpatelqk",
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0",
    "commander": "^12.1.0",
    "domhandler": "^5.0.3",
    "dotenv": "^16.4.5",
    "openai": "^4.65.0",
    "playwright": "^1.48.0",
    "prettier": "^3.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
